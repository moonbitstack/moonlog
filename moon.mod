name = "moonbitstack/moonlog"

version = "0.2.0"

source = "src"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonlog"

license = "Apache-2.0"

keywords = [
  "log",
  "logging",
  "logger",
  "structured-logging",
  "json",
  "logfmt",
  "levels",
  "file",
  "log-rotation",
  "loki",
  "grafana-loki",
  "email",
  "smtp",
  "stdout",
  "serilog",
  "moonbit",
]

description = "Structured logging for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonzip@0.4.0",
  "moonbitstack/moonmail@0.2.0",
  "moonbitstack/moonfetch@0.2.0",
  "moonbitstack/moonyaml@0.2.0",
  "moonbitstack/moontoml@0.2.0",
  "moonbitstack/moonschema@0.2.5",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonbase@0.5.0",
  "moonbitstack/moontls@0.9.17",
  "moonbitstack/moondate@0.1.7",
}
