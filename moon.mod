name = "moonbitstack/moonlog"

version = "0.1.6"

source = "src"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonlog"

license = "Apache-2.0"

keywords = [
  "log",
  "logging",
  "logger",
  "structured-logging",
  "json",
  "logfmt",
  "levels",
  "file",
  "log-rotation",
  "loki",
  "grafana-loki",
  "email",
  "smtp",
  "stdout",
  "serilog",
  "moonbit",
]

description = "Structured logging for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonzip@0.3.6",
  "moonbitstack/moonmail@0.1.4",
  "moonbitstack/moonfetch@0.1.5",
  "moonbitstack/moonyaml@0.1.4",
  "moonbitstack/moontoml@0.1.1",
  "moonbitstack/moonschema@0.2.4",
  "moonbitstack/moonjson@0.4.3",
  "moonbitstack/moonbase@0.4.3",
  "moonbitstack/moontls@0.9.14",
  "moonbitstack/moondate@0.1.4",
}
